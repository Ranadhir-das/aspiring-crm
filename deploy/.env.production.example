# Copy this to .env on the VPS (NOT into git) and fill in real values.
# Generate a real SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=False

SECRET_KEY=REPLACE_WITH_A_REAL_RANDOM_SECRET

DB_NAME=aspiring_crm
DB_USER=aspiring_crm_user
DB_PASSWORD=REPLACE_WITH_A_REAL_STRONG_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Your domain or DDNS hostname, no scheme, no port, comma-separated for multiple.
ALLOWED_HOSTS=crm.example.com

# Full origins (scheme + host, no path) that are allowed to call this API from a browser.
# Native mobile requests (caller-app) do not need CORS at all.
CORS_ALLOWED_ORIGINS=https://crm.example.com

# Required once DEBUG=False and you're behind HTTPS: browser-facing origins allowed
# to submit CSRF-protected POST requests (the Django web UI, not the mobile app).
CSRF_TRUSTED_ORIGINS=https://crm.example.com

# Leave true once Certbot/Nginx HTTPS is working. Set to False only temporarily
# while testing over plain HTTP before the certificate is issued.
SECURE_SSL_REDIRECT=True
