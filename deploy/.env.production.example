# Copy this to .env on the VPS (NOT into git) and fill in real values.
# Generate a real SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=False

SECRET_KEY=REPLACE_WITH_A_REAL_RANDOM_SECRET

DB_NAME=vaani
DB_USER=vaani_user
DB_PASSWORD=REPLACE_WITH_A_REAL_STRONG_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Local Redis, used for the team-chat WebSocket channel layer.
REDIS_URL=redis://127.0.0.1:6379

# Your domain, no scheme, no port, comma-separated for multiple.
ALLOWED_HOSTS=vaaniapp.co.in,www.vaaniapp.co.in

# Full origins (scheme + host, no path) that are allowed to call this API from a browser.
# Native mobile requests (the Vaani app) do not need CORS at all.
CORS_ALLOWED_ORIGINS=https://vaaniapp.co.in

# Required once DEBUG=False and you're behind HTTPS: browser-facing origins allowed
# to submit CSRF-protected POST requests (the Django web UI, not the mobile app).
CSRF_TRUSTED_ORIGINS=https://vaaniapp.co.in

# Leave true once Certbot/Nginx HTTPS is working. Set to False only temporarily
# while testing over plain HTTP before the certificate is issued.
SECURE_SSL_REDIRECT=True

# Absolute path to the release APK on THIS server (see deploy/DEPLOY.md step 11) —
# the /app/ download page reads this file's size/date live, it does not build it.
CALLER_APK_PATH=/opt/vaani/dist/vaani.apk
