# systemd unit for the Django app server.
# Install:
#   sudo cp deploy/aspiring-crm.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aspiring-crm
# Logs:
#   sudo journalctl -u aspiring-crm -f
#
# Adjust User/Group and the paths below to match your actual deploy location
# if you did not put the checkout at /opt/aspiring-crm.

[Unit]
Description=aspiring-crm Gunicorn daemon
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/aspiring-crm
EnvironmentFile=/opt/aspiring-crm/.env
ExecStart=/opt/aspiring-crm/venv/bin/gunicorn \
    --workers 3 \
    --timeout 60 \
    --bind unix:/run/aspiring-crm/gunicorn.sock \
    config.wsgi:application
RuntimeDirectory=aspiring-crm
Restart=on-failure

[Install]
WantedBy=multi-user.target
