# systemd unit for the Vaani app server — Daphne (ASGI), not Gunicorn.
#
# Daphne serves BOTH plain HTTP (the CRM pages, the REST/mobile API) and
# WebSocket (team chat) over the same socket, since config/asgi.py wires up
# a ProtocolTypeRouter for both. That's simpler than running Gunicorn and
# Daphne side by side and routing between them in Nginx.
#
# Install:
#   sudo cp deploy/vaani.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vaani
# Logs:
#   sudo journalctl -u vaani -f
#
# Adjust User/Group and the paths below if you did not put the checkout at
# /opt/vaani.

[Unit]
Description=Vaani Daphne (ASGI) daemon
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/vaani
EnvironmentFile=/opt/vaani/.env
ExecStart=/opt/vaani/venv/bin/daphne \
    --unix-socket /run/vaani/daphne.sock \
    config.asgi:application
RuntimeDirectory=vaani
Restart=on-failure

[Install]
WantedBy=multi-user.target
